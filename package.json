{
  "name": "iags",
  "private": true,
  "version": "0.1.0",
  "license": "Apache-2.0",
  "author": "IA'GS contributors",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "setup:engines": "node scripts/engine-command.mjs setup",
    "verify:engines": "node scripts/engine-command.mjs verify",
    "verify:licenses": "node scripts/verify-licenses.mjs",
    "setup:engines:macos": "bash scripts/setup-engines-macos.sh",
    "verify:engines:macos": "bash scripts/verify-engines-macos.sh",
    "setup:build-deps:macos": "bash scripts/setup-macos-build-deps.sh",
    "build:engines:macos": "bash scripts/build-engines-macos.sh",
    "verify:licenses:macos": "node scripts/verify-licenses.mjs",
    "build:bundle": "npm run build:helper && npm run verify:engines:macos && npm run verify:licenses && npm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "tauri": "tauri",
    "build:helper": "bash script/build_helper.sh",
    "package:macos": "tauri build --bundles app,dmg",
    "start:app": "bash script/build_and_run.sh",
    "test:native": "bash script/test_native.sh"
  },
  "dependencies": {
    "@playcanvas/react": "0.11.5",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.4.0",
    "@tauri-apps/plugin-opener": "^2.5.0",
    "lucide-react": "^0.539.0",
    "mediabunny": "1.52.3",
    "playcanvas": "2.21.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.8.4",
    "@types/node": "^22.17.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.2",
    "vite": "^8.1.0",
    "vitest": "^3.2.4"
  }
}
